# ============================================================================
# DailyNews360 - Environment configuration
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# ============================================================================

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Base URL of the client (used for CORS and cookie settings)
CLIENT_URL=http://localhost:5173

# --- Database -------------------------------------------------------------
# PostgreSQL connection string (Prisma). Update credentials as needed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dailynews360?schema=public

# --- Authentication -------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Cookie name for the auth session
AUTH_COOKIE_NAME=dn360_session

# --- News providers -------------------------------------------------------
# Noozra: no API key required (100 requests/day/IP, CORS enabled).
# Enable/disable per provider. At least one provider must be enabled.
NEWS_PROVIDER_NOOZRA_ENABLED=true
NEWS_PROVIDER_NOOZRA_URL=https://noozra.com

# GNews: free API key (100 requests/day). Get one at https://gnews.io/register
NEWS_PROVIDER_GNEWS_ENABLED=true
NEWS_PROVIDER_GNEWS_API_KEY=

# Currents API: free API key (limited requests). Get one at https://currentsapi.services/en
NEWS_PROVIDER_CURRENTS_ENABLED=false
NEWS_PROVIDER_CURRENTS_API_KEY=

# --- Mock data ------------------------------------------------------------
# Use realistic mock data instead of live providers (DEVELOPMENT ONLY).
# Never enable this in production.
USE_MOCK_NEWS=false

# --- Caching --------------------------------------------------------------
# In-memory cache TTLs (in seconds)
NEWS_CACHE_TTL_TOP=600
NEWS_CACHE_TTL_CATEGORY=600
NEWS_CACHE_TTL_SEARCH=300